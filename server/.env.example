# ディレクター（進行役）の設定。
# 実際の値は .env.local か Vercel の環境変数に置く。**コミットしない。**

# ローカル/Vercel development専用の生成AI内部テストフラグ。
# `NODE_ENV` が production ではなく、`VERCEL_ENV` が未設定または development
# かつ、値が厳密に `1` の場合だけ開く。
# production / preview、および `NODE_ENV=production` は、この値があっても
# コード上で無条件503となる。
# 公開再開は環境変数では行わず、レビュー付きのコード変更で判断する。
# DEKISUGI_INTERNAL_AI_TESTING=1

# 必須。カルテの更新と次の一手を決めるテキスト生成に使う
GEMINI_API_KEY=

# 任意。既定は gemini-3.6-flash
GEMINI_TEXT_MODEL=

# OpenAI Realtimeへのprovider-neutral移行経路（/api/realtime-grant）。
# いずれもローカル/Vercel developmentでの内部検証用。設定しても上記の
# production / preview生成AI hard gateは解除されない。

# 必須。標準API keyはサーバーだけに置き、Flutterへ返さない。
OPENAI_API_KEY=

# OpenAI側で対象projectのZero Data Retentionが有効になったことを確認後だけ
# 厳密に `1` を設定する。申請中・未確認・`true` はすべてfail-closed。
# OPENAI_REALTIME_ZDR_APPROVED=1

# 必須。匿名didをOpenAI-Safety-Identifier用にHMAC化する専用鍵（32文字以上）。
# AUTH_SECRETを流用しない。raw didとこの鍵はOpenAI・Flutterへ返さない。
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
OPENAI_SAFETY_IDENTIFIER_SECRET=

# 必須。端末トークンの署名鍵（32文字以上）。
# 変えると発行済みトークンが全部失効する ＝ 緊急時の停止スイッチにもなる。
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=

# 任意だが**公開前には必須**。Upstash Redis(Vercel Marketplace)の REST 接続情報。
# 無いとレート制限がプロセス内カウンタに落ちる＝インスタンスをまたがず気休めになる。
# 繋がっているかは /api/director の応答ヘッダ X-RateLimit-Backend で分かる。
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 任意。チームの招待コードを発行するための管理トークン。
# **未設定なら発行の経路ごと 401 で閉じる**（設定を忘れた瞬間に
# 誰でもチームを量産できる、という形にしない）。
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TEAM_ADMIN_TOKEN=

# ローカル/Vercel development専用の学校Team API内部テストフラグ。
# AIのフラグとは分離する。production / preview、および `NODE_ENV=production` は
# 設定しても開かない。
# DEKISUGI_INTERNAL_SCHOOL_TESTING=1

# ローカル/Vercel development専用の制限対象データ処理テストフラグ。
# subscription-syncとRevenueCat webhookをまとめて開くため、
# AI・学校Teamのフラグとは分離する。値は厳密に `1` の場合だけ有効。
# production / preview、および `NODE_ENV=production` は設定しても開かない。
# 公開再開は環境変数では行わず、DPA確認を伴うコード変更で判断する。
# DEKISUGI_INTERNAL_RESTRICTED_DATA_TESTING=1

# 匿名アンケートPOSTだけの運用スイッチ。値が厳密に `1` のときだけ開く。
# 生成AI・学校Team・RevenueCatのguardとは共有しない。氏名・学校名・連絡先のfield、
# 端末情報・IPは受け付けない。自由記述には個人情報を書かないよう画面でも案内する。
# productionでは明示設定が無い限り503。
# DEKISUGI_ANONYMOUS_SURVEY_ENABLED=1

# 必要な場合だけ追加するcross-origin配布元（カンマ区切り、https exact origin）。
# 同一originの /survey/* とVercel deployment URLは自動で許可される。
# DEKISUGI_SURVEY_ALLOWED_ORIGINS=

# 任意。端末が言語を明示しないときの既定（ja / en）。
# **配布済みの端末に手を入れずに切り替えるための逃げ道。**
# 知らない値は ja に倒す（原本が日本語なので、迷ったら原本側へ）。
DEMO_LANG=

# RevenueCat の現在の Plus entitlement をサーバーから確認するための secret API key。
# **公開 SDK key ではない。** Vercel の環境変数にだけ設定する。
REVENUECAT_API_KEY=

# RevenueCat Dashboard で作る entitlement identifier。未設定時のサーバー既定値は `plus`。
REVENUECAT_ENTITLEMENT_ID=

# RevenueCat webhook が Authorization ヘッダーに付ける共有 secret。
# ランダムな値を RevenueCat Dashboard と Vercel に同じように設定する。
REVENUECAT_WEBHOOK_AUTH=

# アンケートの集計・削除APIに使う管理トークン。未設定なら経路ごと401で閉じる。
# SURVEY_ADMIN_TOKEN=
