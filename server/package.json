{
  "name": "dekisugi-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "catalog:generate": "node --import tsx scripts/generate-bundled-catalog.ts",
    "catalog:check": "node --import tsx scripts/generate-bundled-catalog.ts --check",
    "test": "tsc --noEmit && node --import tsx --test \"test/*.test.ts\"",
    "test:social:lan": "node --import tsx --test test/lan_social.test.ts test/lan_social_http.test.ts test/lan_social_tls.test.ts",
    "test:live": "node --import tsx --test test/director.live.test.ts",
    "dev": "vercel dev",
    "social:lan": "node --import tsx scripts/lan-social-server.ts",
    "social:binary": "node scripts/build-lan-social-binary.mjs",
    "social:binary:reproducible": "node scripts/verify-lan-social-binary-reproducible.mjs",
    "social:binary:smoke": "node scripts/smoke-lan-social-binary.mjs",
    "deploy": "vercel deploy --prod",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@types/ws": "^8.18.1",
    "google-auth-library": "^11.0.0",
    "selfsigned": "5.5.0",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "0.28.1",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "yazl": "3.3.1"
  }
}
