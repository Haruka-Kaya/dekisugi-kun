# ---- IDE ----
.idea/
.vscode/
*.swp
*~

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- シークレット ----
# 鍵・トークンの類は絶対に追跡しない
.env
.env.*
!.env.example
**/secrets/
*.pem
*.p12
service-account*.json

# ---- 調査ツールの一時生成物 ----
# アンケートの実回答（個人の回答なので追跡しない。集計結果だけを残す）
tools/type-survey/codes.txt
tools/type-survey/results/
# フォント生成の中間ファイル（index.html に埋め込み済みのため不要）
tools/type-survey/NotoSansJP-VF.ttf
tools/type-survey/NSJP-*.ttf
tools/type-survey/NSJP-*.woff2
tools/type-survey/font_b64.txt

# 実機計測の生ログ
tools/*/measurements/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/

# 誤概念スパイクの生成物（再実行で作り直せる。結論は RESULTS.md に残す）
tools/misconception-spike/results.json
tools/misconception-spike/run*.log
tools/misconception-spike/.env.local
